---
const projects = [
  { number: '01', type: 'PRODUCT PLATFORM', title: 'Movix', text: 'A fast, editorial movie discovery experience with rich APIs, smart filters, and a visual browsing rhythm.', tags: ['React', 'Redux', 'REST API'], theme: 'violet', href: 'https://movix-site.vercel.app/' },
  { number: '02', type: 'REAL ESTATE', title: 'H-Rent', text: 'A focused rental platform that turns property search into a clear, confident decision-making flow.', tags: ['Next.js', 'Node.js', 'Database'], theme: 'sand', href: 'https://rent-in.vercel.app/' },
  { number: '03', type: 'STARTUP ECOSYSTEM', title: 'Embarkist', text: 'A modular product ecosystem designed to help ambitious teams move from first idea to real traction.', tags: ['Strategy', 'Cloud', 'Systems'], theme: 'mint', href: 'https://embarkisttesting.netlify.app/' },
]
const skills = ['React / Next.js', 'TypeScript', 'Node.js', 'PostgreSQL', 'AWS / Vercel', 'System design', 'Design systems', 'Technical strategy']
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f0e9" />
    <title>Shivam Singh — Product engineer & CTO</title>
    <meta name="description" content="Shivam Singh is a product engineer and CTO building thoughtful, scalable digital products." />
  </head>
  <body>
    <header class="site-header"><a class="wordmark" href="#top">shivam<span>.</span></a><nav><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav><a class="header-note" href="mailto:hello@wrkwithshivam.dev">Available for select work <span>↗</span></a></header>
    <main id="top">
      <section class="hero wrap"><div class="hero-meta"><span>SHIVAM SINGH</span><span>PRODUCT ENGINEER / CTO</span></div><div class="hero-grid"><div><p class="greeting">Good morning, world.</p><h1>I build products<br />people <em>remember.</em></h1></div><div class="hero-intro"><p>I&apos;m a full-stack engineer and technology leader turning complicated ideas into calm, capable software.</p><a class="text-link" href="#work">See selected work <span>↓</span></a></div></div><div class="hero-foot"><span>Based in India · Working globally</span><span class="scroll-cue">Scroll to explore <b>↓</b></span></div></section>
      <section id="work" class="work wrap"><div class="section-top"><p class="eyebrow">01 / SELECTED WORK</p><p class="section-note">A few things I&apos;ve helped bring<br />from 0 → 1 and beyond.</p></div><div class="project-list">{projects.map((project) => <article class={`project ${project.theme}`}><div class="project-art"><div class="browser"><div class="browser-bar"><i></i><i></i><i></i><span>product / overview</span></div><div class="mock-body"><span class="mock-kicker">{project.type}</span><strong>{project.title}</strong><div class="mock-lines"><i></i><i></i><i></i></div><div class="mock-blocks"><b></b><b></b><b></b></div></div></div><span class="project-no">{project.number}</span></div><div class="project-info"><p class="eyebrow">{project.type}</p><h2>{project.title}</h2><p>{project.text}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><a class="text-link" href={project.href} target="_blank" rel="noreferrer">Visit project <span>↗</span></a></div></article>)}</div></section>
      <section id="about" class="about wrap"><div class="section-top"><p class="eyebrow">02 / A LITTLE ABOUT ME</p></div><div class="about-grid"><h2>Good technology<br />feels <em>inevitable.</em></h2><div class="about-copy"><p class="large-copy">I work where product thinking meets engineering craft. My job is to make the right things possible — and make them feel simple once they exist.</p><p>As CTO at Embarkist, I lead technical direction, architecture, and the hands-on work of building products that can keep their promises as they grow.</p><a class="button" href="mailto:hello@wrkwithshivam.dev">Start a conversation <span>↗</span></a></div></div></section>
      <section class="capabilities wrap"><div class="section-top"><p class="eyebrow">03 / CAPABILITIES</p><p class="section-note">The tools change.<br />The principles don&apos;t.</p></div><div class="skill-grid">{skills.map((skill, i) => <div class="skill"><span>0{i + 1}</span><strong>{skill}</strong></div>)}</div></section>
      <section id="contact" class="contact wrap"><div><p class="eyebrow">04 / LET&apos;S TALK</p><h2>Have a good<br /><em>problem?</em></h2></div><div class="contact-copy"><p>Tell me what you&apos;re building, where you&apos;re stuck, or what could be better. I&apos;m always interested in thoughtful work with ambitious people.</p><a class="email" href="mailto:hello@wrkwithshivam.dev">hello@wrkwithshivam.dev <span>↗</span></a></div></section>
    </main>
    <footer class="site-footer wrap"><a class="wordmark" href="#top">shivam<span>.</span></a><span>© {new Date().getFullYear()} · Built with intention</span><div><a href="https://github.com" target="_blank" rel="noreferrer">Github ↗</a><a href="https://linkedin.com" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></footer>
  </body>
</html>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap');
:root{--ink:#1d211e;--muted:#6d716b;--paper:#f3f0e9;--line:#d8d6cd;--accent:#a8c768}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,system-ui,sans-serif}a{color:inherit;text-decoration:none}.wrap{max-width:1240px;margin:auto;padding-left:36px;padding-right:36px}.site-header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 36px;border-bottom:1px solid var(--line);font-size:12px}.wordmark{font-size:20px;font-weight:700;letter-spacing:-.06em}.wordmark span{color:#8ba34e}.site-header nav{display:flex;gap:32px;color:var(--muted)}.site-header nav a:hover,.site-footer a:hover{color:#819842}.header-note{font-family:'DM Mono';font-size:10px;color:var(--muted)}.header-note span{color:var(--ink);font-size:15px}.hero{padding-top:104px;padding-bottom:46px;min-height:615px}.hero-meta,.hero-foot,.section-top,.site-footer{display:flex;justify-content:space-between;align-items:center;font:10px 'DM Mono';letter-spacing:.08em;color:var(--muted);text-transform:uppercase}.hero-meta{border-bottom:1px solid var(--line);padding-bottom:18px}.hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:80px;padding-top:58px}.greeting{font-size:13px;color:var(--muted);margin:0 0 24px}.hero h1,.about h2,.contact h2{font-size:clamp(52px,7.5vw,105px);line-height:.98;letter-spacing:-.07em;font-weight:600;margin:0}.hero h1 em,.about h2 em,.contact h2 em{font-family:'Playfair Display';font-weight:500}.hero-intro{align-self:end;padding-bottom:8px;max-width:310px}.hero-intro p,.about-copy p,.contact-copy p{font-size:16px;line-height:1.6;color:#555a53}.text-link{display:inline-flex;gap:18px;align-items:center;border-bottom:1px solid var(--ink);padding-bottom:7px;margin-top:28px;font:11px 'DM Mono';text-transform:uppercase}.text-link span{font-size:16px}.hero-foot{margin-top:118px}.scroll-cue b{font-size:18px;margin-left:12px;color:var(--ink)}.work,.about,.capabilities,.contact{padding-top:100px;padding-bottom:112px}.section-top{align-items:flex-start;border-top:1px solid var(--line);padding-top:17px;margin-bottom:45px}.eyebrow{font:10px 'DM Mono';letter-spacing:.1em;color:var(--muted);margin:0;text-transform:uppercase}.section-note{font-size:12px;line-height:1.5;color:var(--muted);margin:0;text-align:right}.project-list{display:grid;gap:28px}.project{display:grid;grid-template-columns:1.45fr .55fr;min-height:445px;border:1px solid var(--line);overflow:hidden}.project-art{position:relative;padding:42px;display:flex;align-items:center;justify-content:center;background:#d9d2c9}.project.violet .project-art{background:#d4d4c9}.project.mint .project-art{background:#c9d2c4}.browser{width:82%;height:270px;background:#fcfbf7;box-shadow:0 22px 38px #34342b22;transform:rotate(-3deg);overflow:hidden}.browser-bar{height:28px;background:#eeeae0;display:flex;align-items:center;padding:0 12px;gap:5px}.browser-bar i{width:6px;height:6px;border-radius:50%;background:#b7b7ad}.browser-bar span{font:8px 'DM Mono';color:#92968b;margin-left:12px}.mock-body{padding:30px}.mock-kicker{font:8px 'DM Mono';color:#8da450;display:block;margin-bottom:18px}.mock-body strong{font-size:33px;letter-spacing:-.08em}.mock-lines{display:grid;gap:5px;margin-top:20px}.mock-lines i{display:block;height:4px;background:#e2e1d9;width:72%}.mock-lines i:nth-child(2){width:48%}.mock-lines i:nth-child(3){width:60%}.mock-blocks{display:flex;gap:9px;margin-top:28px}.mock-blocks b{height:54px;flex:1;background:#c9d88f}.mock-blocks b:nth-child(2){background:#e6d2ba}.mock-blocks b:nth-child(3){background:#d6d8ce}.project-no{position:absolute;top:18px;right:20px;font:11px 'DM Mono';color:#6d716b}.project-info{padding:51px 46px;display:flex;flex-direction:column;align-items:flex-start}.project-info h2{font-size:45px;letter-spacing:-.06em;margin:10px 0 14px}.project-info>p:not(.eyebrow){font-size:14px;line-height:1.6;color:var(--muted);max-width:295px;margin:0}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}.tags span{font:9px 'DM Mono';border:1px solid var(--line);padding:8px 9px;color:var(--muted)}.project-info .text-link{margin-top:25px}.about{border-top:1px solid var(--line)}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.about h2,.contact h2{font-size:clamp(48px,6vw,80px)}.about-copy{max-width:460px}.large-copy{font-size:22px!important;color:var(--ink)!important;line-height:1.4!important}.button{display:inline-flex;gap:20px;margin-top:25px;background:var(--ink);color:var(--paper);padding:15px 18px;font:10px 'DM Mono';text-transform:uppercase}.skill-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.skill{padding:25px 16px;border-right:1px solid var(--line);display:grid;gap:35px}.skill:first-child{border-left:1px solid var(--line)}.skill span{font:10px 'DM Mono';color:#91ac51}.skill strong{font-size:17px;letter-spacing:-.04em}.contact{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);padding-bottom:145px}.contact-copy{max-width:410px;padding-top:10px}.email{font:13px 'DM Mono';display:inline-flex;gap:20px;border-bottom:1px solid var(--ink);padding-bottom:8px;margin-top:24px}.email span{font-size:18px}.site-footer{border-top:1px solid var(--line);padding-top:22px;padding-bottom:30px}.site-footer>span{font-size:9px}.site-footer div{display:flex;gap:20px}.site-footer div a{font-size:10px}@media(max-width:700px){.wrap{padding-left:20px;padding-right:20px}.site-header{padding:0 20px;height:64px}.site-header nav{display:none}.header-note{font-size:8px}.hero{padding-top:70px;min-height:570px}.hero-grid,.about-grid,.contact,.project{grid-template-columns:1fr;gap:40px}.hero h1{font-size:60px}.hero-intro{padding:0}.hero-foot{margin-top:90px}.section-top{margin-bottom:30px}.section-note{text-align:left}.project-art{min-height:290px;padding:24px}.browser{width:90%;height:205px}.mock-body{padding:20px}.mock-body strong{font-size:26px}.project-info{padding:30px 24px;min-height:330px}.project-info h2{font-size:40px}.tags{margin-top:30px}.work,.about,.capabilities,.contact{padding-top:75px;padding-bottom:78px}.skill-grid{grid-template-columns:1fr 1fr}.skill{padding:18px 12px;gap:38px}.skill:nth-child(3){border-left:1px solid var(--line)}.contact{gap:35px;padding-bottom:100px}.site-footer{align-items:flex-start;gap:18px;flex-wrap:wrap}.site-footer>span{order:3;width:100%}}
</style>
<script>
  const links = document.querySelectorAll('a[href^="#"]')
  links.forEach((link) => link.addEventListener('click', () => document.body.classList.remove('menu-open')))
</script>
