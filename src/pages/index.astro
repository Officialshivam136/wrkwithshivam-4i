pan{font:7px 'DM Mono';color:#8d8c83;margin-left:auto}.window-body{height:210px;background:#d9d7cd;padding:27px 30px;color:#222}.window-body small{font:8px 'DM Mono';letter-spacing:.1em;color:#706f68}.window-body strong{display:block;font-size:30px;letter-spacing:-.06em;margin-top:10px}.chart{height:51px;display:flex;align-items:end;gap:7px;margin-top:25px}.chart i{width:17%;background:#6c895a;height:40%}.chart i:nth-child(2){height:62%}.chart i:nth-child(3){height:50%}.chart i:nth-child(4){height:85%;background:#9d554f}.chart i:nth-child(5){height:72%}.blocks{display:flex;gap:8px;margin-top:17px}.blocks b{height:21px;flex:1;background:#bab8ad}.project-detail{align-self:center;max-width:340px}.project-detail h2,.process h2{font-size:clamp(39px,5vw,70px);letter-spacing:-.07em;font-weight:500;margin:17px 0 18px}.project-detail>p:not(.eyebrow),.process article p{color:#97968e;line-height:1.7;font-size:14px}.tags{display:block;color:var(--green);font:10px 'DM Mono';margin:29px 0}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.process article{border-top:1px solid var(--line);padding-top:17px}.process article>span{font:10px 'DM Mono';color:var(--muted)}.process h2{font-size:46px;margin:43px 0 16px}.stack-content{display:grid;grid-template-columns:1fr 1fr;gap:80px;margin-top:74px}.stack h2,.contact h2{font-size:clamp(44px,6vw,84px);line-height:1;letter-spacing:-.07em;font-weight:500;margin:0}.stack-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.stack-list span{padding:17px 0;border-bottom:1px solid var(--line);font:12px 'DM Mono';color:#b1b0a8}.contact{padding-bottom:140px}.contact>div{display:grid;grid-template-columns:1fr 1fr;gap:80px;margin-top:72px}.contact-copy{max-width:360px;align-self:end}.contact-copy p{color:#9a9990;font-size:15px;line-height:1.7}.email{display:inline-block;color:var(--green);font:13px 'DM Mono';border-bottom:1px solid #49654b;padding-bottom:10px;margin-top:24px}.email span{margin-left:1