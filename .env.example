# Site
NEXT_PUBLIC_SITE_URL=https://shivamsingh.dev

# ─────────────────────────────────────────────────────────────
# Email — REQUIRED for you to receive enquiries and call bookings
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in SMTP_PASS. Then run:
#     npm run test:email
# It logs in and sends you a test message, so you know it works.
#
# Gmail setup (2 minutes):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (no spaces).
#
# On Vercel/Netlify: add the same variables in the project's
# Environment Variables settings. Saved files do not persist there,
# so email is how you receive everything.

# Where enquiries and bookings are delivered
CONTACT_EMAIL=shivam.klg136@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shivam.klg136@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Optional: a permanent Google Meet link (create one at https://meet.google.com/new).
# If set, it is put in every booking email and calendar invite.
# If empty, the emails say you will share the Meet link before the call.
MEETING_LINK=
